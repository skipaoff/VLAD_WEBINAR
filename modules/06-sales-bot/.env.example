# Секреты продавца. Скопируй в .env рядом с bot.py и впиши значения.
# .env в git не попадает, ключи в чат не диктуются.
# Всё, что не секрет — канал, модель, темп, голос — лежит в config.json.

# ─── всегда ───

# Ключ Anthropic — им продавец думает. console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ─── канал "bot": обычный бот от @BotFather ───

# Токен от @BotFather. Продавец работает от своего имени, не от твоего аккаунта.
BOT_TOKEN=

# Твой telegram id — туда идут новые диалоги, эскалации, вложения и ошибки (@userinfobot).
ADMIN_CHAT_ID=

# ─── канал "userbot": живой аккаунт через Telethon ───
# my.telegram.org → API development tools → создать приложение.
# Работаешь ботом — эти две строки не нужны.
TG_API_ID=
TG_API_HASH=

# ─── голос, по желанию ───

# Ключ ElevenLabs. Одним ключом продавец и слушает голосовые, и озвучивает ответы.
# Пусто — работает текстом, ничего не ломается. Голос настраивается в config.json.
ELEVENLABS_API_KEY=

# Ключ OpenAI — запасной способ расшифровки голосовых.
# Нужен, только если в config.json стоит "stt": "openai".
OPENAI_API_KEY=
