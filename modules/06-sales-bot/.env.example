# Секреты продавца. Скопируй в .env рядом с bot.py и впиши значения.
# .env в git не попадает. Ключи в чат не диктуются.
#
# Всё, что не секрет — имя продавца, язык, id голоса и его настройки —
# лежит в tenant.json.

# Токен бота от @BotFather. Бот работает от своего имени, не от аккаунта человека.
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic — им бот думает.
ANTHROPIC_API_KEY=

# Модель и глубина размышлений. Для переписки хватает low.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# Ключ ElevenLabs — им бот слушает голосовые и озвучивает ответы.
# Пусто — работает текстом, ничего не ломается.
# Сам голос (id, чей, характер, настройки) настраивается в tenant.json.
ELEVENLABS_API_KEY=

# Напоминания молчащим: через сколько часов и сколько раз максимум.
FOLLOWUP_HOURS=20
FOLLOWUP_MAX=2
