# Скопируй в worker/.env и впиши реальные значения.
# Файл .env в git не попадает (см. .gitignore). Ключи не уходят в браузер:
# сайт получает только короткоживущий токен из /api/voice-token.

# Gemini API-ключ с доступом к Gemini Live (платный).
GEMINI_API_KEY=

# LiveKit Cloud — проект под этот демо-контур.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
