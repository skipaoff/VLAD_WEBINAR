# Доступ к рекламному кабинету Facebook. Скопируй в .env и впиши значения.
# Файл .env в git не попадает. Ключи не диктуются в чат и не пишутся в промпт.

# ID кабинета, обязательно с префиксом act_
META_AD_ACCOUNT_ID=act_

# Токен с правами ads_management, ads_read, pages_show_list, pages_read_engagement.
# Обычный токен живёт ~60 дней, токен System User не протухает.
META_ACCESS_TOKEN=

# Секрет приложения. Нужен, чтобы считать appsecret_proof — подпись,
# без которой приложение с включённой проверкой не принимает запросы.
META_APP_SECRET=

# ID приложения. Нужен для отладки токена.
META_APP_ID=

# Версия Graph API. Поднять, если Facebook ответит, что версия устарела.
META_API_VERSION=v23.0
