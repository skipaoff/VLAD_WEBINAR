# Доступ к рекламному кабинету. Скопируй в .env и впиши значения.
# .env в git не попадает, в чат не диктуется, на экран прогона не выводится.

# ID кабинета, с префиксом act_
META_AD_ACCOUNT_ID=act_

# Токен с правами ads_management, ads_read, pages_show_list, pages_read_engagement
META_ACCESS_TOKEN=

# Секрет приложения — для подписи запросов
META_APP_SECRET=

# ID приложения — для проверки токена
META_APP_ID=

# Версия Graph API. Поднять, если Facebook скажет, что версия устарела.
META_API_VERSION=v23.0
