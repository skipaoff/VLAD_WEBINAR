# Ключи всех модулей в одном месте. Скопируй в .env в корне репозитория и заполни один раз.
# Модули находят этот файл сами — в промптах и в чате ключи не упоминаются.
#
# Если агент в эфире заберёт репозиторий заново, корневой .env в новую копию не попадёт.
# На этот случай тот же файл можно положить в ~/.config/vlad-webinar/.env — его модули
# тоже находят. Порядок: .env модуля → этот файл → ~/.config/vlad-webinar/.env.
#
# Проверка готовности, без показа значений:  python3 check_env.py

# ─── 03 Видеоконсультант ─────────────────────────────────────────────
# platform.tavus.io → API Keys
TAVUS_API_KEY=

# ─── 05 Реклама ──────────────────────────────────────────────────────
# ID кабинета с префиксом act_ — Ads Manager → Настройки аккаунта
META_AD_ACCOUNT_ID=act_
# Business Manager → Системные пользователи → токен с правами
# ads_management, ads_read, pages_manage_ads, pages_show_list, pages_read_engagement
META_ACCESS_TOKEN=
# developers.facebook.com → приложение → Settings → Basic
META_APP_SECRET=
META_APP_ID=
META_API_VERSION=v23.0

# ─── 06 Продавец в Telegram ──────────────────────────────────────────
# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# elevenlabs.io — для голосовых ответов; пусто — продавец отвечает текстом
ELEVENLABS_API_KEY=

# ─── 07 Консьерж ─────────────────────────────────────────────────────
# my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
